<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/widget_subtext"
                android:textSize="11sp" />
        </LinearLayout>

        <!--
          模式切换：接下来 / 整天。
          这里原来是 30dp 的方形图标（ic_widget_list），用户根本看不出那是什么 ——
          实测反馈是"右下角一个正方形不知道干嘛的"，还容易和图片占位符搞混。
          改成写着当前模式的文字胶囊：一眼知道现在看的是哪一种，点一下切换。
        -->
        <TextView
            android:id="@+id/widget_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="@color/widget_now"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_refresh"
            android:textColor="@color/widget_now"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
      可滚动列表：用 ListView + RemoteViewsService 是安卓可滚动小组件的唯一正路。
      高度在运行时按「能放下几个整行」精确设置（见 TodayWidgetProvider.build），
      这样不会出现被切掉一半的第三行。这里的 94dp = 2 行，只是取不到尺寸时的兜底。

      图片开着时，行数是**先扣掉图片预留高度**再算的（WidgetData.rowsFor / photoReserveDp）：
      于是同一档高度里拖动组件，行数不变、多出来的高度归图片。这是用户要的
      "课程数固定、向下拉图片出现在下侧"，而不是"向下拉又多一行课"。
    -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_marginTop="8dp"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:requiresFadingEdge="none"
        android:scrollbars="none" />

    <!--
      这里不再放加权占位控件（Space / View）：两者都没有 @RemoteView 注解，
      不在 RemoteViews 白名单内，桌面 inflate 会直接失败、小组件变空白。
      列表高度已经按整行精确计算，余量只剩几 dp，不需要占位。
    -->

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_no_class"
        android:textColor="@color/widget_subtext"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_subtext"
        android:textSize="10sp" />

    <!--
      每日一句：只在你打开开关、且列表下方**确实有余量**时显示（见 WidgetData.extraSpaceDp）。
      单行 + 省略号：宁可截断，也不让它把小组件撑高、把课程挤走。
    -->
    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_subtext"
        android:textSize="11sp"
        android:visibility="gone" />

    <!--
      图片框：一个 FrameLayout 包一个 ImageView。
        · 高度由代码按「列表下方真实剩下的高度」用 setViewLayoutHeight 设置
          （见 WidgetData.photoBoxTargetDp / WidgetExtras.apply）；
        · **整块（这个 FrameLayout）都可点** → 换下一张（Provider 的 ACTION_NEXT_PHOTO 广播）。
          点挂在这一层而不是里面的 ImageView：ImageView 默认不消费点击，事件照样落到这里，
          所以"图还没解出来/留白"时点上去也有反应；这块的高度就等于图片的高度，
          不会多占课程列表的位置，也不会抢列表的手势（ListView 自己处理自己的滑动）。

      **这里不再有 AdapterViewFlipper**。曾经用它做自动轮播（宿主自己翻页），
      但它是个可滚动的 AdapterView：竖直手势被它吃掉，课程列表就滑不动了 ——
      真机反馈"自动轮播启动后小组件无法使用"就是它。现在自动换图改由 PhotoAutoAdvance
      定时局部重画这一个 ImageView，整块布局里没有任何会吃手势的轮播控件。

      ## scaleType="fitCenter" 是**两条渲染分支的安全默认值**，不是随便选的

      代码用 PhotoFit.layout 产出两种位图，两种都满足"宽度逐像素等于框宽、高度 ≤ 框高"：

        · 放得下（完整显示）：位图 = 框宽 × 按图自身比例算出的高（≤ 框高）→
          fitCenter 的缩放因子 = min(1, 框高/位图高) = 1，只做居中，一个像素都不裁、不缩放，
          多出来的上下部分就是**这块 FrameLayout 自己的圆角背景**（留边不会变成黑边）；
        · 放不下（取裁剪图的中间一块）：位图 = 框的像素尺寸 → fitCenter 是恒等变换。

      以前这里写的是 centerCrop（配"填满"模式）。centerCrop 在第一种情况下会把
      "已经完整显示的图"重新放大到铺满、把左右裁掉 —— 那正是用户抱怨的"显示不全"。
      换掉之后，宿主端不再需要任何 setInt("setScaleType")，渲染结果只由我们自己产出的位图决定。
    -->
    <FrameLayout
        android:id="@+id/widget_photo_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_photo_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_photo_desc"
            android:scaleType="fitCenter" />
    </FrameLayout>
</LinearLayout>
