<?xml version="1.0" encoding="utf-8"?>
<!--
  图片轮播的一项。

  用 ImageView + centerCrop：图片由启动器按 ImageView 的尺寸解码显示，
  我们只传 URI（见 PhotoWidgetService.Modify），这样**不会碰 RemoteViews 1MB 的 binder 上限** ——
  直接塞 Bitmap 的话，两三张大图就会把这次更新整包丢掉（小组件表现为"更新了但没变化"）。
-->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photo_item"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/widget_photo_desc"
    android:scaleType="centerCrop" />
