<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建生效：
  1) 注册自检广播，用于在没有桌面宿主的情况下验证小组件 RemoteViews，
     以及验证明文 HTTP 策略（NETCHECK）。
  release 包不含此项。

  明文策略不在这里配置，见 res/xml/network_security_config.xml
  （设置了 networkSecurityConfig 后 usesCleartextTraffic 会被忽略）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <receiver
            android:name="app.timetable.debug.DebugSelfCheckReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.timetable.debug.SELFCHECK" />
                <action android:name="app.timetable.debug.NETCHECK" />
                <action android:name="app.timetable.debug.RENDERCHECK" />
                <action android:name="app.timetable.debug.STYLECHECK" />
                <action android:name="app.timetable.debug.FEATURECHECK" />
                <action android:name="app.timetable.debug.SEED" />
                <action android:name="app.timetable.debug.PHOTOSEED" />
                <action android:name="app.timetable.debug.PINWIDGET" />
                <action android:name="app.timetable.debug.GREETCHECK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
